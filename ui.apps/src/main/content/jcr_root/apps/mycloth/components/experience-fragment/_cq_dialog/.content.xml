<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Properties"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs">
                <items jcr:primaryType="nt:unstructured">
                    <category1
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Category 1"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <category1Path
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Category 1 Path"
                                name="./category1Path"
                                rootPath="/content/mycloth"/>
                            <category1Depth
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                fieldLabel="Category 1 Depth"
                                name="./category1Depth"
                                min="{Long}1"
                                step="{Long}1"/>
                        </items>
                    </category1>
                    <category2
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Category 2"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <category2Path
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Category 2 Path"
                                name="./category2Path"
                                rootPath="/content/mycloth"/>
                            <category2Depth
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                fieldLabel="Category 2 Depth"
                                name="./category2Depth"
                                min="{Long}1"
                                step="{Long}1"/>
                        </items>
                    </category2>
                    <category3
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Category 3"
                        sling:resourceType="granite/ui/components/coral/foundation/container">
                        <items jcr:primaryType="nt:unstructured">
                            <category3Path
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Category 3 Path"
                                name="./category3Path"
                                rootPath="/content/mycloth"/>
                            <category3Depth
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                fieldLabel="Category 3 Depth"
                                name="./category3Depth"
                                min="{Long}1"
                                step="{Long}1"/>    
                        </items>
                    </category3>
                </items>
            </tabs>
        </items>    
    </content>  
</jcr:root>